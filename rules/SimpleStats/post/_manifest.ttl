@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix kgi: <http://ns.inria.fr/kg/index#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<> a mf:Manifest ;
    mf:entries  (
        <recountClasses.ttl>
        <recountProperties.ttl>
        <vocabularyPartition.ttl>
    )
    .

<recountClasses.ttl> a mf:ManifestEntry ;
    kgi:onSuccess (
        [
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
            PREFIX kgi: <http://ns.inria.fr/kg/index#>
                INSERT {
                    GRAPH ?endpointUrl {
                        ?datasetDescription void:classes ?count .
                    }
                }
                WHERE {
                    {
                        SELECT DISTINCT ?endpointUrl (COUNT(DISTINCT ?class) AS ?count) {
                            BIND(Iri(CONCAT(str(kgi:), MD5(str(?endpointUrl)), "Dataset")) AS ?datasetDescription)  
                            GRAPH ?endpointUrl {
                                ?datasetDescription void:classPartition ?classPartition .
                                ?classPartition void:class ?class .
                            }
                        } GROUP BY ?endpointUrl
                    }
                    BIND(Iri(CONCAT(str(kgi:), MD5(str(?endpointUrl)), "Dataset")) AS ?datasetDescription)  
                }
            """
        ]
    ) .

<recountProperties.ttl> a mf:ManifestEntry ;
    kgi:onSuccess (
        [
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
            PREFIX kgi: <http://ns.inria.fr/kg/index#>
                INSERT {
                    GRAPH ?endpointUrl {
                        ?datasetDescription void:properties ?count .
                    }
                }
                WHERE {
                    {
                        SELECT DISTINCT ?endpointUrl (COUNT(DISTINCT ?property) AS ?count) {
                            BIND(Iri(CONCAT(str(kgi:), MD5(str(?endpointUrl)), "Dataset")) AS ?datasetDescription)  
                            GRAPH ?endpointUrl {
                                ?datasetDescription void:propertyPartition ?propertyPartition . 
                                ?propertyPartition void:property ?property .
                            }
                        }  GROUP BY ?endpointUrl
                    }
                    BIND(Iri(CONCAT(str(kgi:), MD5(str(?endpointUrl)), "Dataset")) AS ?datasetDescription)  
                }
            """
        ]
    ) .
    


<vocabularyPartition.ttl> a mf:ManifestEntry ;
    kgi:onSuccess (
        [
            kgi:recommendedPagination 10 ;
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX dcterms: <http://purl.org/dc/terms/>
            PREFIX kgi: <http://ns.inria.fr/kg/index#>
            INSERT {
                GRAPH ?endpointUrl {
                    ?datasetDescription kgi:vocabularyPartition ?vocabularyPartition .
                    ?vocabularyPartition void:vocabulary ?ns .
                }
            }
            WHERE {
                    {
                        SELECT DISTINCT ?ns {
                            {
                                SELECT DISTINCT ?elem {
                                    GRAPH ?endpointUrl {
                                        ?datasetDescription void:classPartition ?classPartition .
                                        ?classPartition void:class ?elem .
                                    }
                                }
                            }
                            BIND(IRI(REPLACE( str(?elem), "(#|/)[^#/]*$", "$1")) AS ?ns)
                        } GROUP BY ?ns
                    }
                BIND(Iri(CONCAT(str(kgi:), MD5(CONCAT(str(?endpointUrl), str(?ns))) , "VocabularyPartition")) AS ?vocabularyPartition)
            }
            """
        ]
        [
            kgi:recommendedPagination 10 ;
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX earl: <http://www.w3.org/ns/earl#>
            PREFIX dcterms: <http://purl.org/dc/terms/>
            PREFIX kgi: <http://ns.inria.fr/kg/index#>
            INSERT {
                GRAPH ?endpointUrl {
                    ?datasetDescription kgi:vocabularyPartition ?vocabularyPartition .
                    ?vocabularyPartition void:vocabulary ?ns .
                    ?vocabularyPartition void:classes ?count .
                }
            }
            WHERE {
                    {
                        SELECT ?ns (COUNT(?elem) AS ?count) {
                            {
                                SELECT DISTINCT ?elem {
                                    GRAPH ?endpointUrl {
                                        ?datasetDescription void:classPartition ?classPartition .
                                        ?classPartition void:class ?elem .
                                    }
                                }
                            }
                            BIND(IRI(REPLACE( str(?elem), "(#|/)[^#/]*$", "$1")) AS ?ns)
                        } GROUP BY ?ns
                    }
                BIND(Iri(CONCAT(str(kgi:), MD5(CONCAT(str(?endpointUrl), str(?ns))) , "VocabularyPartition")) AS ?vocabularyPartition)
            }
            """
        ]
        [
            kgi:recommendedPagination 100 ;
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
                PREFIX prov: <http://www.w3.org/ns/prov#>
                PREFIX earl: <http://www.w3.org/ns/earl#>
                PREFIX dcterms: <http://purl.org/dc/terms/>
                PREFIX kgi: <http://ns.inria.fr/kg/index#>
                INSERT {
                    GRAPH ?endpointUrl {
                        ?datasetDescription kgi:vocabularyPartition ?vocabularyPartition .
                        ?vocabularyPartition void:vocabulary ?ns .
                    }
            }
            WHERE {
                {
                    SELECT ?ns {
                        {
                            SELECT DISTINCT ?elem {
                                GRAPH ?endpointUrl {
                                    ?datasetDescription void:propertyPartition ?propertyPartition .
                                    ?propertyPartition void:property ?elem ;
                                }
                           }
                        }
                        BIND(IRI(REPLACE( str(?elem), "(#|/)[^#/]*$", "$1")) AS ?ns)
                    } GROUP BY ?ns
                }
                BIND(Iri(CONCAT(str(kgi:), MD5(CONCAT(str(?endpointUrl), str(?ns))) , "VocabularyPartition")) AS ?vocabularyPartition)
            }
            """
        ]
        [
            kgi:recommendedPagination 100 ;
            mf:action """PREFIX void: <http://rdfs.org/ns/void#>
                PREFIX prov: <http://www.w3.org/ns/prov#>
                PREFIX earl: <http://www.w3.org/ns/earl#>
                PREFIX dcterms: <http://purl.org/dc/terms/>
                PREFIX kgi: <http://ns.inria.fr/kg/index#>
                INSERT {
                    GRAPH ?endpointUrl {
                        ?datasetDescription kgi:vocabularyPartition ?vocabularyPartition .
                        ?vocabularyPartition void:vocabulary ?ns .
                        ?vocabularyPartition void:properties ?count .
                    }
            }
            WHERE {
                    {
                        SELECT ?ns (COUNT(?elem) AS ?count) {
                            {
                                SELECT DISTINCT ?elem {
                                    GRAPH ?endpointUrl {
                                        ?datasetDescription void:propertyPartition ?propertyPartition .
                                        ?propertyPartition void:property ?elem ;
                                    }
                                }
                            }
                            BIND(IRI(REPLACE( str(?elem), "(#|/)[^#/]*$", "$1")) AS ?ns)
                        } GROUP BY ?ns
                    }
                BIND(Iri(CONCAT(str(kgi:), MD5(CONCAT(str(?endpointUrl), str(?ns))) , "VocabularyPartition")) AS ?vocabularyPartition)
            }
            """
        ]
    ) .